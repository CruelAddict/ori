{
  "name": "ori-tui",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "./build.ts",
    "bench:autocomplete": "bun run bench/sql-autocomplete.ts",
    "bench:editor-input": "bun run --preload @opentui/solid/preload bench/editor-buffer-input-lag.tsx",
    "bench:highlight": "bun run bench/sql-highlight.ts",
    "lint": "bunx biome check --reporter summary",
    "lint:fix": "bunx biome check --write",
    "test": "bun test --preload @opentui/solid/preload src",
    "test:run": "bun test --preload @opentui/solid/preload src",
    "test:unit": "bun test --preload @opentui/solid/preload src --path-ignore-patterns 'src/test/integration/**'",
    "test:integration": "bun test --preload @opentui/solid/preload src/test/integration",
    "test:watch": "bun test --watch --preload @opentui/solid/preload src",
    "test:coverage": "bun test --coverage --preload @opentui/solid/preload src"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.5",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "0.2.15",
    "@opentui/solid": "0.2.15",
    "contract": "file:../../libs/contract/typescript",
    "fuzzysort": "^3.1.0",
    "pino": "^9.5.0",
    "solid-js": "1.9.12",
    "web-tree-sitter": "0.25.10"
  }
}
